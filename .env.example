# Port of the local cockpit (UI, API and proxy). The Chrome extension uses this port.
PORT=8787

# Recommended. Your OpenRouter key (the Turing key). The proxy uses it when a request has no Authorization header.
# The cockpit reads the model list of this key (free) to show which models you may use.
# The cockpit also uses it to show the key limit and total usage from OpenRouter.
OPENROUTER_API_KEY=

# Optional. Free key from https://artificialanalysis.ai (benchmark scores). Attribution is shown in the UI.
AA_API_KEY=

# Optional. One key for all free NVIDIA build endpoints (https://build.nvidia.com/settings).
# Shows the "NVIDIA free" tab. Call the models with base_url http://localhost:8787/api/nvidia/v1.
NVIDIA_API_KEY=
